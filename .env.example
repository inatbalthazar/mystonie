# Copy to .env.local. Never commit real values.

# Supabase (stage 0+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Catalog (server-side only)
TMDB_API_TOKEN=
# stage 2
DTDD_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Analytics & errors
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Salt for hashing IPs in rate limits (server-side only, any long random string)
IP_HASH_SALT=

# Cron auth (pg_cron -> route handlers, stage 1)
CRON_SECRET=

# Payments (stage 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
