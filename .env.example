# Copy to .env.local. Never commit real values.

# Supabase (stage 0+). The anon key is public (browser sign-in, RLS applies); the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth Send Email Hook secret (ADR 0020), format v1,whsec_<base64>. Locally: the `secrets` value under
# [auth.hook.send_email] in supabase/config.toml. Production: generated in Supabase → Authentication → Hooks.
SEND_EMAIL_HOOK_SECRET=
# Optional, development: Mailpit of the local Supabase stack (default http://127.0.0.1:54324)
MAILPIT_URL=

# Site origin for metadata, robots and sitemap (e.g. https://mystonie.app). Optional on Vercel:
# falls back to the production *.vercel.app domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Catalog (server-side only). TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
# stage 2
DTDD_API_KEY=
GOOGLE_BOOKS_API_KEY=
# stage 3 games (ADR 0044): a RAWG key from https://rawg.io/apidocs. Empty = game search off (saved games still show).
RAWG_API_KEY=

# Analytics (PostHog, cookieless). Project API key (phc_...). Host defaults to EU cloud:
# https://eu.i.posthog.com (use https://us.i.posthog.com for a US project). Empty key = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Errors (Sentry). The DSN is public by design. Empty = Sentry off (it is also off in development).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build time only: upload source maps so stack traces are readable.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Salt for hashing IPs in rate limits (server-side only, any long random string)
IP_HASH_SALT=

# Cron auth (pg_cron -> /api/cron/weekly-recaps, ADR 0025). At least 16 characters; the same value goes into
# Supabase Vault as `cron_secret`. Locally, set it (and UNSUBSCRIBE_SECRET) to run e2e/recap.spec.ts.
CRON_SECRET=

# Email (Resend, ADR 0019). Server-side only. Empty key = no sending (the launch route answers 503).
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Mystonie <hello@mystonie.app>"
EMAIL_FROM=
# Optional: where replies go (e.g. the operator contact)
EMAIL_REPLY_TO=
# Signs unsubscribe links (any long random string). Changing it breaks links in emails already sent.
UNSUBSCRIBE_SECRET=
# Bearer token for /api/admin/* (at least 16 characters, e.g. `openssl rand -hex 32`)
ADMIN_SECRET=

# Web push for installed apps (ADR 0028). Generate a pair with `pnpm push:keys`. The public key is public by
# design; the private key is server-only (Sensitive in Vercel). Empty = no notifications switch, no pushes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: who push services can contact about our pushes (default mailto:<legal contact>)
VAPID_SUBJECT=

# Pro (stage 2, ADR 0034). Off unless PRO_ENABLED=true, both Stripe keys and at least one price are set.
# Test mode works locally: sk_test_... and the whsec_... printed by `stripe listen`, or any values for
# e2e/pro.spec.ts, which signs its own webhook events.
PRO_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) of the monthly and yearly plans
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
